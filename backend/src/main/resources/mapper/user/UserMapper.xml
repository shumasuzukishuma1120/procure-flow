<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.procureflow.user.infrastructure.UserMapper">

    <select id="findActiveByCognitoSub"
            resultType="com.example.procureflow.security.CurrentUser">
        SELECT
            id,
            department_id
        FROM users
        WHERE cognito_sub = #{cognitoSub}
          AND active = TRUE
    </select>

</mapper>
