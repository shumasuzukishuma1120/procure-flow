<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.procureflow.request.infrastructure.RequestCancellationMapper">

    <insert id="insert">
        INSERT INTO request_cancellations (
            id,
            request_id,
            canceled_by,
            cancel_reason,
            canceled_at
        ) VALUES (
            #{id},
            #{requestId},
            #{canceledBy},
            #{cancelReason},
            #{canceledAt}
        )
    </insert>

</mapper>
