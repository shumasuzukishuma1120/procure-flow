# Browser API mocking with MSW: "enabled" or "disabled"
NEXT_PUBLIC_API_MOCKING=disabled
BACKEND_API_URL=http://localhost:8080

# Auth.js / Amazon Cognito
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_SECRET=replace-with-a-random-secret
AUTH_COGNITO_ID=replace-with-cognito-app-client-id
AUTH_COGNITO_SECRET=replace-with-cognito-app-client-secret
AUTH_COGNITO_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_example
AUTH_COGNITO_DOMAIN=https://example.auth.ap-northeast-1.amazoncognito.com
